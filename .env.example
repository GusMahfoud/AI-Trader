# ---- AI Trader jobs / API (server-only, never commit the real .env) ----

# Supabase Postgres connection string for the personal project.
# Dashboard -> Connect -> "Session pooler" URI (postgresql://postgres.<ref>:...@...pooler.supabase.com:5432/postgres)
AI_TRADER_DB_URL=

# The auth.users id that owns runs submitted by this machine (single-user for now).
# Find it in Supabase Dashboard -> Authentication -> Users after signing up once.
AI_TRADER_USER_ID=

# Worker poll interval in seconds (optional, default 2).
AI_TRADER_POLL_SECONDS=2
